# Local-only by default. Copy to .env and edit; NEVER commit .env.
PORT=4173
SANDBOX_AUTO_CONFIRM=1
# Required for public QR scans: HTTPS URL of the deployed demo.
# PUBLIC_BASE_URL=https://demo.example.com
# For controlled remote team access ONLY, enable all of these:
# PUBLIC_DEMO_MODE=1
# DEMO_USERNAME=teamdemo
# DEMO_PASSWORD=REPLACE_WITH_LONG_RANDOM_16_PLUS_CHARACTER_PASSWORD
# ALLOW_REMOTE_DEMO_OTP=1
# ADMIN_DEMO_OTP=786123
# Optional: use a managed secret for AES key; back up with DB if set.
# ENCRYPTION_KEY_HEX=64_HEX_CHARACTERS
