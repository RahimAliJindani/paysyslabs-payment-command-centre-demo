# Local-only by default. Copy to .env and edit; NEVER commit .env.
PORT=4173
HOST=127.0.0.1
SANDBOX_AUTO_CONFIRM=1
# Required for public QR scans: HTTPS URL of the deployed demo.
# PUBLIC_BASE_URL=https://demo.example.com
# For controlled remote team access ONLY, enable all of these:
# PUBLIC_DEMO_MODE=1
# DEMO_USERNAME=teamdemo
# DEMO_PASSWORD=REPLACE_WITH_LONG_RANDOM_16_PLUS_CHARACTER_PASSWORD
# ALLOW_REMOTE_DEMO_OTP=1
# ADMIN_DEMO_OTP=SET_A_PRIVATE_SIX_DIGIT_DEMO_CODE
# ADMIN_REVIEWER_EMAILS=reviewer@example.com
# Optional: use a managed secret for AES key; back up with DB if set.
# ENCRYPTION_KEY_HEX=64_HEX_CHARACTERS

# Optional merchant-specific accounts. Store actual values only in a private environment/secret manager.
# Without accounts, use the local Enterprise Admin demonstration login to operate the terminal.
# MERCHANT_ACCOUNTS={"salon":{"username":"salon-reviewer","password":"REPLACE_WITH_A_UNIQUE_LONG_PASSWORD"}}
# A merchant account can read/create only its own payments; provider controls require admin.
